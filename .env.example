# URL base de la API para viajes/excel (vacío usa datos mock locales)
VITE_API_URL=

# URL base de la API de autenticación (Django + SimpleJWT).
# Login real en POST {base}/auth/login/ con {username, password} → {access, refresh}.
# Vacío usa login mock local. Ej: https://incoming-hub-00af8e68af77.herokuapp.com/api/v1
VITE_AUTH_URL=

# Google Maps Places API key para autocompletado de origen/destino en viajes.
# Habilitá "Maps JavaScript API" y "Places API" en la consola de Google Cloud.
# Sin esta key, los campos caen al listado local de lugares.
VITE_GOOGLE_MAPS_API_KEY=
